                    Margin="10,36,9.8,10" Foreground="White" TextWrapping="Wrap"/>
        <TextBlock x:Name="tbAuthor" Text="Жанр: вфы вфыв фыв фыв фыв фввы фыв фывфыв фыв фыв фыв"
                    Margin="9.2,36,9.8,10" Foreground="White" TextWrapping="Wrap" Grid.Column="1"/>
    </Grid>
</UserControl>
